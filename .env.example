# APTAMA Attendance — environment configuration
# Copy file ini ke .env, lalu isi kredensial Supabase Anda.
# Dapatkan dari: Supabase Dashboard → Settings → API

# Project URL
# Contoh: https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url

# Anon public key (JANGAN pakai service_role key di frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
